  "buckets": {
    "_comment": "Defines the type and description for each bucket referenced in attributeToBucket.",
    "additive": {
      "type": "additive",
      "description": "Additive damage bucket — all contributing values sum. Applied as (1 + sum)."
    },
    "crit_chance": {
      "type": "stat",
      "description": "Critical Strike Chance — summed across all items, hard-capped at 100%. Used as EV weight in critMult = 1 + CSC × CSD."
    },
    "crit_damage": {
      "type": "stat",
      "description": "Critical Strike Damage — summed across all items, added to csBaseline. Used in EV formula."
    },
    "attack_speed": {
      "type": "stat",
      "description": "Attack Speed — all additive AS affixes sum before breakpoint lookup (except Paladin/Warlock which use linear AS per D34)."
    },
    "vulnerable": {
      "type": "conditional_mult",
      "description": "Vulnerable damage — separate multiplicative bucket applied at vulnerableBaseline × uptime."
    },
    "skill_specific_mult": {
      "type": "distinct_mult",
      "description": "Position B only: Skill-Specific damage as a distinct multiplicative bucket. Use via local override to flip Attr_Core_Skill_Damage_Percent from additive to this bucket."
    },
    "cdr": {
      "type": "stat",
      "description": "Cooldown Reduction — hyperbolic formula: Effective CDR = CDR/(CDR+1.0). Reduces cooldown-gated skill cycle time."
    },
    "primary_stat": {
      "type": "stat",
      "description": "Primary stat (Strength/Intelligence/Willpower/Dexterity). Each point adds primaryStatScalar to damage. Only the class's primary stat is counted."
    },
    "non_damaging": {
      "type": "ignored",
      "description": "Non-damaging stat — no DPS contribution in the engine."
    }
  },
  "constants": {
    "_comment": "Formula constants. All values verified against cited sources; patch-staleness flagged where known.",
    "csBaseline": 0.5,
    "_csBaseline_notes": "Base Critical Strike Damage: 50% bonus when critting. Source: maxroll_damage_s9. Widely verified; believed stable across seasons.",
    "vulnerableBaseline": 0.2,
    "_vulnerableBaseline_notes": "Vulnerable damage multiplier bonus: +20% (total ×1.20). Source: maxroll_damage_s9 (Season 9). PATCH-STALE WARNING: Season 13 changes unverified. Override via data/damage-config.local.json when confirmed. Decision D13.",
    "critBaseChance": 0.05,
    "_critBaseChance_notes": "Base Critical Strike Chance before any affixes: 5%. Source: community_general. Stable across seasons.",
    "enemyDefenseMultiplier": 1,
    "_enemyDefenseMultiplier_notes": "Enemy defense/armor/resistance reduction factor (placeholder 1.0 = no reduction for v1). TODO: populate with boss-level DR formula when datamine source confirmed. Source: not yet implemented."
  },
