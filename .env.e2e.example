# .env.e2e.example — e2e environment configuration template (T8, D14)
#
# Copy to .env.e2e (or .env) before running docker compose:
#   cp .env.e2e.example .env.e2e
#
# Then run: pnpm e2e:ui (which invokes docker compose -f docker-compose.e2e.yml up)

# ─── Port overrides (D14) ────────────────────────────────────────────────────
# Defaults shown — override if ports are in use on the host.
# E2E_APP_PORT=3000
# E2E_UI_PORT=9323
# E2E_REPORT_PORT=9324

# ─── Playwright workers ──────────────────────────────────────────────────────
# Each spec spawns its own next dev (~400MB). Two workers is the default;
# reduce to 1 if the container OOMs.
# PLAYWRIGHT_WORKERS=2
