# Dockerfile.e2e — d4-tools end-to-end test image (T8)
#
# Strategy (D11, D12):
#   - Base: official Playwright jammy image (pins browser + system deps)
#   - Node 24 layered on top via NodeSource apt (D11)
#   - Source is bind-mounted at /workspace — image carries only runtime tooling (D12)
#
# Build:
#   docker build -f Dockerfile.e2e -t d4-tools-e2e .
#
# Usage (see docker-compose.e2e.yml for the one-command bring-up):
#   docker compose -f docker-compose.e2e.yml up

# ─── Build arg: derive Playwright version from package.json ──────────────────
ARG PLAYWRIGHT_VERSION=1.59.1

FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-jammy

# ─── Install Node 24 via NodeSource (D11) ────────────────────────────────────
# The Playwright base image ships Node 20; we need Node >=24.15.0 <25 per
# the project's engines.node constraint. We install from NodeSource's
# official apt repository.
RUN apt-get update && apt-get install -y curl gnupg2 --no-install-recommends \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Verify Node 24 installed
RUN node --version | grep -E '^v24\.' \
    && echo "Node 24 installed successfully"

# ─── Enable corepack for pnpm ─────────────────────────────────────────────────
RUN corepack enable && corepack prepare pnpm@latest --activate

# ─── Working directory (source is bind-mounted at /workspace) ─────────────────
WORKDIR /workspace

# The image carries:
#   - Node 24
#   - pnpm (via corepack)
#   - Playwright + Chromium (from the base image)
#
# Source code and node_modules are bind-mounted from the host.
# Run pnpm install INSIDE the container before running tests.
