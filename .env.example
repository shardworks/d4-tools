# Directory where persisted character/build data is stored.
# Defaults to ./data/ in development.
# Required in production - the app throws at startup if missing.
DATA_DIR=./data/

# Directory containing D4 loot screenshots for the /triage workspace.
# Required always (no dev fallback) — the app throws at startup if unset.
SCREENSHOT_DIR=./screenshots/

# Anthropic API key for Vision-LLM screenshot parsing in /triage.
# Must be kept server-side — never expose to the browser.
ANTHROPIC_API_KEY=

# Optional shared secret for the POST /api/triage/upload endpoint.
# Leave empty (or omit) to disable auth — suitable only for single-host or
# trusted private-LAN deployments. Set to any strong random string when the
# endpoint is reachable from the internet or an untrusted network.
# The PowerShell watcher reads this as UploadSecret in its config file.
UPLOAD_SECRET=
